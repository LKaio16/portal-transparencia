# Copie para .env.local (uso no computador) ou cadastre na Vercel e nos segredos do GitHub (produção).

# Endereço público do site, usado nos links dos e-mails.
SITE_URL=http://localhost:3000

# Texto aleatório e secreto que assina os links de descadastro. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Obrigatório em produção. Use o MESMO valor na Vercel e no GitHub.
SEGREDO_SITE=

# Banco Postgres (Neon, Supabase...). Sem ele, usa um banco local em data/banco-local.
DATABASE_URL=

# Envio de e-mails pelo Resend (https://resend.com). Sem ela, os e-mails viram arquivos em data/emails-enviados.
RESEND_API_KEY=
EMAIL_REMETENTE=Olho no Mandato <alertas@seudominio.com.br>

# Opcional: resumos com IA (npm run resumir).
ANTHROPIC_API_KEY=
